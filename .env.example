# Add these in Vercel -> your project -> Settings -> Environment Variables (never commit real values)

# Locks your deployment so only you can read your trade data. Use 12+ characters; a long passphrase is best.
TAPE_ACCESS_KEY=choose-a-long-passphrase-here

BITUNIX_API_KEY=your_bitunix_api_key
BITUNIX_API_SECRET=your_bitunix_api_secret

# Optional: only needed if you don't connect wallets from the Accounts page
HYPERLIQUID_WALLET=0xyourwalletaddress
